# Exemplo de arquivo .env para MarcWeb (NÃO COMMITAR ESTE ARQUIVO COM VALORES REAIS)
# Copie este arquivo para .env local e preencha com valores seguros.

# Database (dev/test/prod)
POSTGRES_USER=marcuser
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_USER_TEST=marcuser_test
POSTGRES_PASSWORD_TEST=your_test_db_password_here
DB_URL_DEV=jdbc:postgresql://localhost:5432/marcweb_dev
DB_URL_TEST=jdbc:postgresql://localhost:5432/marcweb_test
DB_URL_PROD=jdbc:postgresql://<host>:5432/marcweb_prod

# JWT configuration
# GERE UMA CHAVE SEGURA e armazene em base64 (ex: openssl rand -base64 48)
# Exemplo de geração:
#   openssl rand -base64 48
# Configure o KID atual (ex: key-2026-01) e opcionalmente chaves anteriores separadas por vírgula no formato id:base64key
JWT_SECRET=<sua_chave_base64_aqui>
# Identificador da chave atual (kid)
APPLICATION_SECURITY_JWT_KID=key-2026-01
# Chaves anteriores (id:base64key,id2:base64key2)
APPLICATION_SECURITY_JWT_PREVIOUS_KEYS=

# SSL (opcional)
SSL_KEYSTORE_PASSWORD=change_me
SSL_ENABLED=false

# Redis / caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Notes:
# - Nunca comite o arquivo .env com valores reais.
# - Em produção, prefira provisionar secrets via secret manager (AWS Secrets Manager, Azure Key Vault, etc.)
# - Para rotacionar chaves JWT:
#   1) Adicione a nova chave em previous-keys com um novo id
#   2) Atualize APPLICATION_SECURITY_JWT_KID para o novo kid
#   3) Distribua a nova chave e retire chaves antigas quando não houver mais tokens com o kid antigo