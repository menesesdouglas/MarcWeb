# =============================================================================
# Variáveis de ambiente — REP-P MVP (TR.01)
# Copie este arquivo para .env e preencha os valores reais antes de rodar.
# =============================================================================

# --- Banco de dados (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg2://repp:repp_password@db:5432/repp

# --- Segurança / JWT ---
SECRET_KEY=sua_chave_secreta_muito_longa_e_aleatoria_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS (URL do frontend) ---
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- Servidor ---
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Nível de log ---
LOG_LEVEL=INFO

# --- Senha padrão do primeiro ADM (opcional, para seed inicial) ---
ADM_EMAIL=adm@empresa.com
ADM_PASSWORD=Adm@123456
ADM_NOME=Administrador Sistema
ADM_CPF=000.000.000-00
ADM_MATRICULA=ADM0001